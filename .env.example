# PostgreSQL connection (main and test database)
DATABASE_URL="postgresql://zev:zev_dev_password@localhost:5432/zev?schema=public"
TEST_DATABASE_URL="postgresql://zev:zev_dev_password@localhost:5432/zev_test?schema=public"

# Optional: separate URL for running migrations (npm run db:migrate / db:migrate:new),
# distinct from the pooled runtime DATABASE_URL. Needed when DATABASE_URL points at a
# connection pooler (e.g. PgBouncer in transaction mode) that can't run the DDL/advisory
# locks migrations use — point this at a direct (unpooled) connection instead. Falls
# back to DATABASE_URL when unset; irrelevant for the default Docker setup.
# MIGRATE_DATABASE_URL="postgresql://zev:zev_dev_password@localhost:5432/zev?schema=public"

# Optional: cap the PrismaPg connection pool size (pg's own default is 10 per Pool
# instance — i.e. per running process). Irrelevant on Docker's single long-running
# instance; matters on serverless, where many concurrent instances x an unconfigured 10
# each can exhaust a database's connection limit. Leave unset unless you know you need it.
# DB_POOL_MAX="5"

# Secret for signing session cookies (generate: openssl rand -hex 32)
SESSION_SECRET="change-me"

# Public base URL of the application (used in approval links, QR codes, e-mails).
# Optional in development (defaults to http://localhost:3000); required in production
# — startup fails with a clear error instead of silently generating broken links.
APP_URL="http://localhost:3000"

# Notification providers: "mock" writes to the outbox and simulates delivery.
EMAIL_PROVIDER="mock"          # mock | mailjet
# MAILJET_API_KEY=""            # Mailjet API key (required when EMAIL_PROVIDER=mailjet)
# MAILJET_API_SECRET=""         # Mailjet API secret
# MAILJET_FROM_EMAIL=""         # verified sender address in your Mailjet account
VIBER_PROVIDER="mock"          # mock | viber-bot (real bot API not shipped in MVP)
# VIBER_BOT_TOKEN=""            # Viber bot auth token when a real adapter is added
# VIBER_WEBHOOK_URL=""          # public callback URL for delivery/seen events

# Maximum upload size for scanned documents/attachments, in MB. Drives both the
# application's own size check (attachments.ts) and Next's serverActions.bodySizeLimit
# (next.config.ts), so a rejected upload gets the app's sr-Latn message either way.
# Keep this at 4 (the default) if you deploy to Vercel — its serverless Functions
# reject larger request bodies at the infrastructure level regardless of this setting.
# A Docker-only deployment with no such constraint may raise it.
MAX_UPLOAD_MB="4"

# Legacy only: documents/attachments are stored in Postgres (DocumentBlob/AttachmentBlob),
# not on disk. This only matters for reading rows created before that migration, which
# still carry an absolute on-disk path.
STORAGE_DIR="./var/storage"
